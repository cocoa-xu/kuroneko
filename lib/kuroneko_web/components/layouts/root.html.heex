<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="NanoKVM-Go" suffix=" | NanoKVM-Go">{assigns[:page_title]}</.live_title>
    <script>
      // The appearance chosen in this browser, before anything shows: none
      // follows the system.
      (() => {
        const setTheme = (theme) => {
          try {
            if (theme === "system") localStorage.removeItem("phx:theme");
            else localStorage.setItem("phx:theme", theme);
          } catch (_) {}
          if (theme === "system") document.documentElement.removeAttribute("data-theme");
          else document.documentElement.setAttribute("data-theme", theme);
        };
        let saved = null;
        try { saved = localStorage.getItem("phx:theme"); } catch (_) {}
        setTheme(saved === "light" || saved === "dark" ? saved : "system");
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="min-h-screen bg-base-200 text-base-content antialiased">
    {@inner_content}
  </body>
</html>
